# Optional PostgreSQL connection. Leave blank to use local SQLite.
DATABASE_URL=

# Django settings. Use a fresh private SECRET_KEY for deployment.
SECRET_KEY=replace-with-a-private-random-secret
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Gmail SMTP for local email. Use a Google App Password, not your normal password.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=your-gmail-address@gmail.com
EMAIL_HOST_PASSWORD=your-16-character-google-app-password
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL="BudgetAI <your-gmail-address@gmail.com>"

# OpenAI-compatible DeepSeek API used for receipt reading and finance chat.
OPENAI_API_KEY=replace-with-your-deepseek-api-key
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_RECEIPT_MODEL=deepseek-flash
OPENAI_CHAT_MODEL=deepseek-flash

# Optional S3-compatible object storage for uploaded receipts and reports.
USE_CLOUD_STORAGE=False
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_STORAGE_BUCKET_NAME=
