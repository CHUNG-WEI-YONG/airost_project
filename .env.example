# Optional: leave empty to use local SQLite, or paste your PostgreSQL URL.
DATABASE_URL=

# Django deployment settings. Generate a private SECRET_KEY for deployment.
SECRET_KEY=replace-with-a-private-random-secret
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Email settings. Replace placeholders with working SMTP credentials to send email.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=your-sender@gmail.com
EMAIL_HOST_PASSWORD=replace-with-your-app-password
DEFAULT_FROM_EMAIL="BudgetAI <your-sender@gmail.com>"

# Receipt extraction through the OpenAI-compatible DeepSeek API.
OPENAI_API_KEY=your-deepseek-api-key
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_RECEIPT_MODEL=deepseek-flash

# Optional S3-compatible file storage.
USE_CLOUD_STORAGE=False
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_STORAGE_BUCKET_NAME=

EMAIL_TIMEOUT=10