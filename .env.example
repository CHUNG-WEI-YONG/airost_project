# Optional: leave empty to use local SQLite, or paste your PostgreSQL URL.
DATABASE_URL=

# Email settings. Replace placeholders with working SMTP credentials to send email.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=your-sender@gmail.com
EMAIL_HOST_PASSWORD=replace-with-your-app-password
DEFAULT_FROM_EMAIL="BudgetAI <your-sender@gmail.com>"

